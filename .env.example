# Copy to .env and fill in. See docs/dev/configuration.md for every variable.
SOABOX_MODE=dev
SOABOX_PUBLIC_URL=http://localhost:8080
SOABOX_PDNS_URL=http://pdns:8081
# Required. Must match PDNS_AUTH_API_KEY below. Generate with: openssl rand -hex 24
SOABOX_PDNS_API_KEY=
# Generate with: openssl rand -base64 32
SOABOX_SECRET_KEY=
SOABOX_DATABASE_URL=sqlite://data/soabox.db
# Required behind a reverse proxy: the proxy's address or network, for example 10.0.0.5/32
SOABOX_TRUSTED_PROXIES=
SOABOX_BOOTSTRAP_ADMIN_USERNAME=admin
SOABOX_BOOTSTRAP_ADMIN_PASSWORD=
# Single sign-on is normally set up in the UI under Settings > Single sign-on.
# Setting SOABOX_OIDC_ISSUER instead configures it here and makes the UI
# read-only. Leave these commented out to manage it in the UI.
# SOABOX_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SOABOX_OIDC_CLIENT_ID=
# SOABOX_OIDC_CLIENT_SECRET=
# SOABOX_OIDC_BUTTON_LABEL=Sign in with Microsoft

# Used by the development PowerDNS container.
PDNS_AUTH_API_KEY=
